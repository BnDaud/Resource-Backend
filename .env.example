DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=product-images
JWT_SECRET=change-me-long-random
JWT_EXPIRE_MINUTES=480
FRONTEND_ORIGIN=http://localhost:5173
SITE_URL=
COOKIE_SECURE=false
ENVIRONMENT=development
# Field encryption. BACK THESE UP SEPARATELY: lose them and encrypted data is unrecoverable.
# ENCRYPTION_KEYS: comma-separated Fernet keys, newest first (older ones kept only to decrypt after rotation).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEYS=
# BLIND_INDEX_KEY: HMAC key for searchable lookups (staff email, name/phone search). Never rotate casually.
BLIND_INDEX_KEY=
